# Configuration only — NO Smarkets credentials. Login is form-only (see TASK.md):
# the user types their username/password into the login form and Auth.js exchanges
# them for a session token held only in the encrypted, HTTP-only JWT cookie.

# Secret used to sign/encrypt the Auth.js session cookie. Required.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

NEXT_PUBLIC_APP_NAME='Smarkets Clone'

# Set to "enabled" to start MSW server-side mocks via instrumentation.ts.
# Leave unset to hit the real Smarkets API.
API_MOCKING=enabled
